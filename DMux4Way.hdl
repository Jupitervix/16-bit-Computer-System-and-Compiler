// File name: projects/01/DMux4Way.hdl

/**
 * 4-way demultiplexor:
 * {a, b, c, d} = {in, 0, 0, 0} if sel == 00
 *                {0, in, 0, 0} if sel == 01
 *                {0, 0, in, 0} if sel == 10
 *                {0, 0, 0, in} if sel == 11
 */

CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    Not(in=sel[1],out=notsel1); 
    And(a=notsel1,b=sel[0],out=selAvsB);

    Not(in=sel[0],out=notsel0);
    And(a=notsel0,b=sel[1],out=rest0vsC); 

    And(a=sel[0],b=sel[1],out=rest1vsD); 

    DMux(in=in,sel=selAvsB,a=rest0,b=b); 
    DMux(in=rest0,sel=rest0vsC,a=rest1,b=c); 
    DMux(in=rest1,sel=rest1vsD,a=a,b=d); 
}