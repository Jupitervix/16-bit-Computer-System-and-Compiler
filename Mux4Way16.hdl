// File name: projects/01/Mux4Way16.hdl

/**
 * 4-way 16-bit multiplexor:
 * out = a if sel == 00
 *       b if sel == 01
 *       c if sel == 10
 *       d if sel == 11
 */

CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];

    PARTS:
    Not(in=sel[1],out=notsel1); 
    And(a=notsel1,b=sel[0],out=selAvsB);

    Not(in=sel[0],out=notsel0);
    And(a=notsel0,b=sel[1],out=sel0vsC); 

    And(a=sel[0],b=sel[1],out=sel1vsD); 
    
    Mux16(a=a,b=b,sel=selAvsB,out=winner0);
    Mux16(a=winner0,b=c,sel=sel0vsC,out=winner1);
    Mux16(a=winner1,b=d,sel=sel1vsD,out=out);
}