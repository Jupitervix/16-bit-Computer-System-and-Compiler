// File name: projects/02/FullAdder.hdl

/**
 * Computes the sum of three bits.
 */

CHIP FullAdder {
    IN a, b, c;  // 1-bit inputs
    OUT sum,     // Right bit of a + b + c
        carry;   // Left bit of a + b + c

    PARTS:
    HalfAdder(a=b,b=c,sum=sum0, carry=carry0);

    Xor(a=sum0,b=a,out=sum); 

    Not(in=a,out=nota); 
    And(a=carry0,b=nota,out=carrypart0);
    Or(a=b,b=c,out=borc); 
    And(a=a,b=borc,out=carrypart1); 
    Or(a=carrypart0,b=carrypart1,out=carry); 
}